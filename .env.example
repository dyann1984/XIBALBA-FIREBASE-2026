# Copia este archivo como `.env.local` y rellena los valores de TU proyecto de
# Firebase. `.env.local` está ignorado por Git: no lo subas nunca.
#
# Las variables NEXT_PUBLIC_* llegan al navegador por definición. No son
# secretos: la configuración pública de Firebase está pensada para ser visible.
# Lo que protege el proyecto son las reglas de Firestore y App Check, no el
# ocultamiento de estos valores.

# --- Firebase (obligatorias para la interpretación de IA) --------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- App Check --------------------------------------------------------------
# Clave de sitio de reCAPTCHA Enterprise registrada en App Check. SIN ESTA
# CLAVE la aplicación funciona solo con la auditoría local: la interpretación de
# IA no se habilita y el endpoint /api/audit/external responde 401.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Modo de depuración de App Check. Solo surte efecto en `next dev` y en
# localhost; en producción se ignora. Déjalo en `false` salvo durante el
# desarrollo local.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG=false

# Token de depuración de App Check, registrado en la consola de Firebase. Es
# privado: no lleva prefijo NEXT_PUBLIC y solo se entrega al navegador desde
# localhost, en desarrollo y con la cabecera X-Xibalba-Local-Debug.
FIREBASE_APP_CHECK_DEBUG_TOKEN=

# --- Auditorías externas (DNS y RDAP) ---------------------------------------
# Interruptor del servidor. Vacío o distinto de `1` mantiene DNS y RDAP
# deshabilitados: las evidencias correspondientes se emiten como pendientes.
# Actívalo solo de forma consciente: hace que el servidor consulte resolutores
# DoH y servidores RDAP públicos.
XIBALBA_EXTERNAL_AUDITS=
